DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/finance_dashboard
APP_ENV=development
FRONTEND_URL=http://127.0.0.1:3101
FRONTEND_PORT=3101
START_FRONTEND=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# Адрес, доступный получателю письма; для доступа с другого устройства нужен HTTPS-адрес приложения.
PUBLIC_BASE_URL=http://127.0.0.1:8001
# Параметры SMTP вашего почтового сервиса. Секреты храните только в .env (он игнорируется Git).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_SSL=false
